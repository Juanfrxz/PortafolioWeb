    "jsdom": "29.1.1",
    "meshoptimizer": "1.0.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/instrument-sans": "5.2.8",
    "@fontsource/dm-mono": "5.2.7",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "astro": "7.0.9",
    "driver.js": "1.3.6",
