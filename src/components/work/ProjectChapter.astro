---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import { en, es } from '../../i18n';
import type { Locale } from '../../lib/locale';
import { resolveProjectImage, technologyLabel } from '../../lib/project-media';
import ArchitectureMap from './ArchitectureMap.astro';
import ProjectIdentityFallback from './ProjectIdentityFallback.astro';

type ProjectEntry = CollectionEntry<'projects'>;

interface Props {
  locale: Locale;
  project: ProjectEntry;
  index?: number;
  headingLevel?: 1 | 2 | 3;
  caseHref?: string;
  backHref?: string;
  variant?: 'home' | 'index' | 'case';
}

const {
  locale,
  project,
  index = project.data.featuredOrder ?? 1,
  headingLevel = 3,
  caseHref,
  backHref,
  variant = 'home',
} = Astro.props;
const dictionary = locale === 'en' ? en : es;
const data = project.data;
const teamAttribution = data.teamAttribution[locale];
const TitleHeading =
  headingLevel === 1 ? 'h1' : headingLevel === 2 ? 'h2' : 'h3';
const SectionHeading =
  headingLevel === 1 ? 'h2' : headingLevel === 2 ? 'h3' : 'h4';

const ownershipLabel =
  data.ownership === 'individual'
    ? dictionary.work.individual
    : dictionary.work.collaborative;

const statusLabel = {
  shipped: dictionary.projectStatus.shipped,
  'in-progress': dictionary.projectStatus.inProgress,
  archived: dictionary.projectStatus.archived,
}[data.status];

const projectLinks = [
  {
    kind: 'repository',
    label: dictionary.projectStatus.repository,
    availability: data.repository,
  },
  {
    kind: 'demo',
    label: dictionary.projectStatus.demo,
    availability: data.demo,
  },
  {
    kind: 'documentation',
    label: dictionary.projectStatus.documentation,
    availability: data.documentation,
  },
] as const;

const availableLinks = projectLinks.filter(
  (link) => link.availability.state === 'available',
);
const unavailableLinks = projectLinks.filter(
  (link) => link.availability.state !== 'available',
);
const visualMedia = data.media.find(
  (media) => media.kind === 'image' || media.kind === 'diagram',
);
const fallbackMedia = data.media.find(
  (media) => media.kind === 'identity-fallback',
);
const projectImage = visualMedia
  ? resolveProjectImage(visualMedia.src)
  : undefined;
const fallbackAlt =
  fallbackMedia?.alt[locale] ?? `${data.title[locale]} project identity`;
---

<article
  class:list={['project-chapter', `project-chapter--${variant}`]}
  data-project-chapter={data.slug}
  data-ownership={data.ownership}
  data-project-index={index}
  aria-labelledby={`${data.slug}-${variant}-title`}
>
  <div class="project-chapter__inner wrapper">
    <header class="project-chapter__header flow">
      <p class="project-chapter__index" aria-hidden="true">
        {String(index).padStart(2, '0')}
      </p>
      <div class="project-chapter__signals cluster">
        <span data-project-status={data.status}>{statusLabel}</span>
        <span data-project-ownership={data.ownership}>{ownershipLabel}</span>
      </div>
      <TitleHeading id={`${data.slug}-${variant}-title`}>
        {data.title[locale]}
      </TitleHeading>
      <p class="project-chapter__summary">{data.summary[locale]}</p>
      {
        data.ownership === 'collaborative' && teamAttribution.length > 0 && (
          <p class="project-chapter__attribution" data-team-attribution>
            {teamAttribution.join(' · ')}
          </p>
        )
      }
    </header>

    <figure class="project-chapter__identity" data-project-identity>
      {
        visualMedia && projectImage ? (
          <Image
            src={projectImage}
            alt={visualMedia.alt[locale]}
            width={visualMedia.width}
            height={visualMedia.height}
            widths={[480, 768, 1024, 1275]}
            sizes="(max-width: 56rem) 100vw, 60vw"
            format="webp"
            loading={variant === 'case' ? 'eager' : 'lazy'}
            decoding="async"
          />
        ) : (
          <ProjectIdentityFallback
            title={data.title[locale]}
            alt={fallbackAlt}
            index={index}
            nodeLabel={dictionary.work.nodeLabel}
            identitySignalLabel={dictionary.work.identitySignal}
          />
        )
      }
    </figure>

    <div class="project-chapter__evidence">
      <section class="flow">
        <SectionHeading>{dictionary.work.problem}</SectionHeading>
        <p>{data.problem[locale]}</p>
      </section>

      <section class="flow">
        <SectionHeading>{dictionary.work.contribution}</SectionHeading>
        <p>{data.contribution[locale]}</p>
      </section>

      <section class="flow project-chapter__architecture">
        <SectionHeading>{dictionary.work.architecture}</SectionHeading>
        <ArchitectureMap
          nodes={data.architectureNodes}
          edges={data.architectureEdges}
          connectsToLabel={dictionary.work.connectsTo}
        />
      </section>

      <section class="flow">
        <SectionHeading>{dictionary.work.decisions}</SectionHeading>
        <ul class="project-chapter__decisions">
          {data.decisions[locale].map((decision) => <li>{decision}</li>)}
        </ul>
      </section>

      <section class="flow">
        <SectionHeading>{dictionary.work.outcome}</SectionHeading>
        <p>{data.outcome[locale]}</p>
      </section>

      <section class="flow">
        <SectionHeading>{dictionary.work.technologies}</SectionHeading>
        <ul class="project-chapter__technologies" role="list">
          {
            data.technologies.map((technology) => (
              <li>
                <code>{technologyLabel(technology)}</code>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <footer class="project-chapter__links">
      {
        backHref && (
          <a href={backHref} data-back-to-work>
            <span aria-hidden="true">←</span> {dictionary.work.backToIndex}
          </a>
        )
      }
      {
        caseHref && (
          <a href={caseHref} data-case-study-link>
            {dictionary.work.viewCase} <span aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        availableLinks.map((link) => (
          <a
            href={link.availability.url}
            target="_blank"
            rel="noopener noreferrer"
            data-project-link={link.kind}
            data-link-state="available"
          >
            {link.label}
          </a>
        ))
      }
      {
        unavailableLinks.map((link) => (
          <span
            data-project-link={link.kind}
            data-link-state={link.availability.state}
          >
            {link.kind === 'demo' || link.availability.state === 'source-only'
              ? dictionary.work.sourceOnly
              : `${link.label}: ${dictionary.projectStatus.unavailable}`}
          </span>
        ))
      }
    </footer>
  </div>
</article>

<style>
  @layer components {
    .project-chapter {
      min-block-size: 85vh;
      min-block-size: 85dvb;
      padding-block: clamp(4rem, 9vw, 9rem);
      border-block-start: 1px solid var(--color-border);
    }

    .project-chapter--case {
      min-block-size: auto;
      padding-block-start: clamp(2.5rem, 6vw, 6rem);
      border-block-start: 0;
    }

    .project-chapter__inner {
      display: grid;
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      gap: clamp(2rem, 6vw, 7rem);
    }

    .project-chapter__header {
      --flow-space: 1.25rem;
      align-self: start;
    }

    .project-chapter__index,
    .project-chapter__signals,
    .project-chapter__attribution,
    .project-chapter__links {
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .project-chapter__signals span {
      padding: 0.35rem 0.55rem;
      border: 1px solid var(--color-border);
    }

    .project-chapter__signals [data-project-ownership='individual'] {
      border-color: var(--color-signal);
      color: var(--color-signal);
    }

    .project-chapter__header :is(h1, h2, h3) {
      max-inline-size: 12ch;
      font-size: clamp(2.5rem, 5vw, 5.25rem);
      font-weight: 560;
      letter-spacing: -0.055em;
      line-height: 0.96;
      text-wrap: balance;
    }

    .project-chapter--case .project-chapter__header h1 {
      font-size: clamp(3.2rem, 8vw, 8rem);
    }

    .project-chapter__summary {
      max-inline-size: 42rem;
      color: var(--color-muted);
      font-size: 1.12rem;
    }

    .project-chapter__identity {
      align-self: start;
      margin: 0;
    }

    .project-chapter__identity :global(img) {
      inline-size: 100%;
      block-size: auto;
      border: 1px solid var(--color-border);
      background: var(--color-panel);
    }

    .project-chapter__evidence {
      grid-column: 2;
      display: grid;
      gap: 2.5rem;
    }

    .project-chapter__evidence section {
      --flow-space: 0.8rem;
      padding-block-start: 1rem;
      border-block-start: 1px solid var(--color-border);
    }

    .project-chapter__evidence :is(h2, h3, h4) {
      color: var(--color-signal);
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 400;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    .project-chapter__evidence p,
    .project-chapter__decisions {
      max-inline-size: 50rem;
      color: var(--color-muted);
    }

    .project-chapter__decisions {
      display: grid;
      gap: 0.55rem;
      padding-inline-start: 1.25rem;
    }

    .project-chapter__technologies {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
    }

    .project-chapter__technologies li {
      padding: 0.4rem 0.6rem;
      border: 1px solid var(--color-border);
      color: var(--color-text);
      font-size: 0.78rem;
    }

    .project-chapter__links {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-block-start: 2rem;
      border-block-start: 1px solid var(--color-border);
    }

    .project-chapter__links a,
    .project-chapter__links > span {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      gap: 0.4rem;
      padding-inline: 0.875rem;
      border: 1px solid var(--color-border);
    }

    .project-chapter__links a {
      color: var(--color-text);
      text-decoration: none;
    }

    .project-chapter__links a:hover {
      border-color: var(--color-signal);
      color: var(--color-signal);
    }

    .project-chapter__links > span {
      color: var(--color-muted);
    }

    @media (max-width: 56rem) {
      .project-chapter {
        min-block-size: auto;
      }

      .project-chapter__inner {
        grid-template-columns: 1fr;
      }

      .project-chapter__evidence,
      .project-chapter__links {
        grid-column: auto;
      }
    }
  }
</style>
