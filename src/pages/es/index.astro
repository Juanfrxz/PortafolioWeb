---
import { getCollection } from 'astro:content';

import CapabilityList from '../../components/capabilities/CapabilityList.astro';
import ContactSection from '../../components/contact/ContactSection.astro';
import HeroCopy from '../../components/hero/HeroCopy.astro';
import HeroFallback from '../../components/hero/HeroFallback.astro';
import Footer from '../../components/layout/Footer.astro';
import HudNavigation from '../../components/layout/HudNavigation.astro';
import SiteShell from '../../components/layout/SiteShell.astro';
import SignalTrail from '../../components/profile/SignalTrail.astro';
import SelectedWork from '../../components/work/SelectedWork.astro';
import { es as dictionary } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homePath, type Locale } from '../../lib/locale';
import { getFeaturedProjects, getSortedExperience } from '../../lib/projects';

const locale: Locale = 'es';
const alternateLocale: Locale = 'en';

const [projectEntries, rawExperienceEntries] = await Promise.all([
  getCollection('projects'),
  getCollection('experience'),
]);

const featuredProjects = getFeaturedProjects(projectEntries);
const experienceEntries = getSortedExperience(rawExperienceEntries);
---

<BaseLayout
  locale={locale}
  title="Juan Rodriguez — Desarrollador Full-Stack Creativo"
  description={dictionary.hero.support}
  canonicalPath={homePath(locale)}
  alternatePath={homePath(alternateLocale)}
>
  <SiteShell>
    <HudNavigation locale={locale} />
    <main id="main-content" tabindex="-1">
      <section id="system-core" tabindex="-1">
        <HeroCopy locale={locale} />
        <HeroFallback />
      </section>
      <SelectedWork locale={locale} projects={featuredProjects} />
      <section id="capabilities" tabindex="-1">
        <CapabilityList locale={locale} projects={featuredProjects} />
      </section>
      <SignalTrail locale={locale} entries={experienceEntries} />
      <ContactSection locale={locale} />
    </main>
    <Footer locale={locale} />
  </SiteShell>
</BaseLayout>

<style>
  #system-core {
    display: grid;
    min-block-size: calc(100vh - 4.5rem);
    min-block-size: calc(100dvb - 4.5rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 7rem);
    inline-size: min(
      calc(100% - (var(--page-gutter) * 2)),
      var(--content-width)
    );
    margin-inline: auto;
    padding-block: clamp(4rem, 8vw, 8rem);
    scroll-margin-block-start: 5rem;
  }

  #capabilities {
    padding-block: clamp(5rem, 11vw, 11rem);
    border-block-start: 1px solid var(--color-border);
    scroll-margin-block-start: 5rem;
  }

  @media (max-width: 56rem) {
    #system-core {
      min-block-size: auto;
      grid-template-columns: 1fr;
    }
  }
</style>
